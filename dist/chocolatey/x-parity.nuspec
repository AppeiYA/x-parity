<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>x-parity</id>
    <version>1.0.0</version>
    <title>X-Parity</title>
    <authors>AppeiYA</authors>
    <owners>AppeiYA</owners>
    <projectUrl>https://github.com/AppeiYA/x-parity</projectUrl>
    <licenseUrl>https://github.com/AppeiYA/x-parity/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>devops ci-cd drift-detection parity cli systems-engineering</tags>
    <summary>Cross-platform environment drift detection &amp; parity verification engine</summary>
    <description>
      X-Parity eliminates "works on my machine" syndrome by capturing host OS, kernel,
      language runtimes, and sanitized environment configurations, executing semantic difference
      analysis with cross-platform normalization.
    </description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>

